# Copy to .env.test (or export these values in the shell that runs pytest).
# The running backend must use this exact isolated database as DATABASE_URL.
TEST_BASE_URL=http://localhost:5173
TEST_API_BASE_URL=http://localhost:5000/api
TEST_DATABASE_URL=postgresql://USER:PASSWORD@HOST/digicampus_test?sslmode=require
TEST_DATABASE_EXPECTED_NAME=digicampus_test
TEST_DATABASE_EXPECTED_SCHEMA=
TEST_DATABASE_ISOLATED=true
TEST_ALLOW_DESTRUCTIVE=false
TEST_COMMANDER_EMAIL=commander@example.test
TEST_COMMANDER_PASSWORD=replace-me
TEST_ADMIN_EMAIL=admin@example.test
TEST_ADMIN_PASSWORD=replace-me
TEST_CADET_EMAIL=cadet@example.test
TEST_CADET_PASSWORD=replace-me
HEADLESS=false
CHROME_BINARY=

# Required only by `npm run test:physical` in backend/.
# These must point to an isolated test database; this smoke test creates and removes one submission.
TEST_JWT_SECRET=replace-with-the-test-api-jwt-secret
TEST_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
TEST_SUPABASE_SERVICE_ROLE_KEY=replace-with-a-test-project-service-role-key
TEST_SUPABASE_VIDEOS_BUCKET=physical-videos
