# Supabase PostgreSQL connection (server-side only)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres?sslmode=require
JWT_SECRET=replace-with-a-long-random-secret
FRONTEND_ORIGIN=http://localhost:5173

# Supabase Storage (server-side service-role key only; never use VITE_ for this key)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-supabase-service-role-key
SUPABASE_VIDEOS_BUCKET=physical-videos

# Password-reset delivery
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-provider-app-password
SMTP_FROM="Delta Squad Foundation <your-email@gmail.com>"
# In development, omit SMTP_* to log the dynamic reset link locally instead of sending email.
